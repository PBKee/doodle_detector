detectors/        # trained detector snapshots
*.pkl

# --- Model weights / torch hub cache (large, re-downloaded) ---
*.pt
*.pth
*.onnx
.cache/

# --- Datasets / imagery (large + license-restricted: keep out of the repo) ---
*.tif
*.tiff
datasets/
data/
